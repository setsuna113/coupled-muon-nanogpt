{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task|Workflow|mcp__.*__create_session)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-model-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
